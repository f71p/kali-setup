#!/usr/bin/env bash
# keys [search] — search every keybind and command in the cheat sheet, as you type.
#   keys          everything
#   keys copy     start with "copy" typed in
# Reads the cheat sheet itself (copied to ~/.local/share/kali-setup by the dotfiles tag),
# so it's always as up to date as CHEATSHEET.md.
set -euo pipefail
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0
fi

sheet=${KEYS_CHEATSHEET:-$HOME/.local/share/kali-setup/CHEATSHEET.md}
[[ -r $sheet ]] || { echo "keys: no cheat sheet at $sheet (run ./bootstrap.sh --tags dotfiles)" >&2; exit 1; }

# Every table row as "keys <tab> what it does (section)", skipping header and divider rows.
awk '
    /^## /          { sec = substr($0, 4); subsec = ""; next }
    /^\*\*[^*]+\*\*/ { subsec = substr($0, 3); sub(/\*\*.*/, "", subsec); next }
    /^\|/ {
        line = $0; gsub(/\\\|/, "\001", line)            # keep escaped pipes inside cells
        n = split(line, c, /[ \t]*\|[ \t]*/)
        if (c[2] ~ /^-+$/ || n < 4) next
        if (prev !~ /^\|/) { prev = $0; next }            # first row of a table is its header
        k = c[2]; d = c[3]
        for (i = 4; i < n; i++) d = d " · " c[i]
        gsub(/`/, "", k); gsub(/`/, "", d); gsub(/\001/, "|", k); gsub(/\001/, "|", d)
        printf "\033[1m%s\033[0m\t%s  \033[90m(%s)\033[0m\n", k, d, (subsec != "" ? sec " · " subsec : sec)
    }
    { prev = $0 }
' "$sheet" | column -t -s $'\t' |
    fzf --ansi --exact --query="$*" --wrap --layout=reverse --height=100% \
        --prompt='keys> ' --header='type to search · Esc to close' --bind 'enter:ignore' >/dev/null || true
