#!/usr/bin/env bash
# logcat <log>... — print `rec` logs as plain text, the way they looked on screen.
# Replays each line like a terminal would (cursor moves, overwrites, erases) so shell
# redraws (syntax highlighting, completion) don't leave garbage, and drops colour codes.
set -euo pipefail
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0
fi
[ $# -gt 0 ] || { echo "usage: logcat <log>..." >&2; exit 1; }
for f in "$@"; do
    perl -CSD -ne '
        next if /^Script (started|done) on /;
        chomp; s/\r$//;
        s/\e\][^\a\e]*(?:\a|\e\\)//g;                  # OSC (titles, clipboard)
        my @buf; my $col = 0;
        while (length) {
            if    (s/^\e\[([0-9;?]*)([ -\/]*)([@-~])//) {  # CSI sequence
                my ($p, $c) = ($1, $3); my $n = ($p =~ /^(\d+)/ ? $1 : 1);
                if    ($c eq "D") { $col -= $n; $col = 0 if $col < 0 }
                elsif ($c eq "C") { $col += $n }
                elsif ($c eq "G") { $col = $n - 1 }
                elsif ($c eq "K") { splice(@buf, $col) if ($p eq "" || $p eq "0") && $col < @buf }
                elsif ($c eq "P") { splice(@buf, $col, $n) if $col < @buf }
                elsif ($c eq "@") { splice(@buf, $col, 0, (" ") x $n) if $col <= @buf }
            }
            elsif (s/^\e[()][0-9A-Za-z]// || s/^\e[=>78DEHMNOc]//) { }
            elsif (s/^\r//)  { $col = 0 }
            elsif (s/^\x08//) { $col-- if $col > 0 }
            elsif (s/^([\x00-\x1f\x7f])//) { }
            elsif (s/^(.)//s) { $buf[$col++] = $1 }
        }
        (my $out = join("", map { defined ? $_ : " " } @buf)) =~ s/\s+$//;
        print "$out\n";
    ' -- "$f"
done
