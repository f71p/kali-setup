#!/usr/bin/env bash
# timesync — set the clock to a DC's time (Kerberos needs < 5 min skew), or back to real time.
#   timesync <dc>     set the clock from the DC (NTP, falling back to SMB if udp/123 is filtered)
#   timesync reset    back to real time (automatic NTP sync on again)
# Automatic sync (systemd + VMware tools) is turned off while on DC time, or it would undo the change.
set -euo pipefail
if [[ ${1:-} == -h || ${1:-} == --help || $# -eq 0 ]]; then
    sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0
fi

vmware_sync() { command -v vmware-toolbox-cmd >/dev/null && sudo vmware-toolbox-cmd timesync "$1" >/dev/null || true; }

if [[ $1 == reset ]]; then
    sudo timedatectl set-ntp true
    vmware_sync enable
    sleep 2
    date; exit
fi

dc=$1
if t=$(TZ=UTC timeout 5 rdate -np "$dc" 2>/dev/null) && [[ -n $t ]]; then
    remote=$(date -d "$t" +%s)
elif t=$(timeout 30 nmap -Pn -sT -p445 --script smb2-time "$dc" 2>/dev/null | awk '/\| *date:/ {print $NF}') && [[ -n $t ]]; then
    remote=$(date -ud "$t" +%s)
else
    echo "timesync: no time from $dc (tried NTP and SMB)" >&2; exit 1
fi
sudo timedatectl set-ntp false
vmware_sync disable
sudo date -s "@$remote"
