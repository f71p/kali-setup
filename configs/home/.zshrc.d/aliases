# Aliases that replace Kali's defaults: loaded at the very end of ~/.zshrc, after its own ls aliases.

# eza: ls with colours, icons (kitty ships the icon font) and git status
if command -v eza >/dev/null; then
    alias ls='eza --group-directories-first --icons=auto'
    alias ll='eza -lah --group-directories-first --icons=auto --git'
    alias la='eza -a --group-directories-first --icons=auto'
    alias l='eza -1 --group-directories-first --icons=auto'
    alias lt='eza --tree --level=2 --group-directories-first --icons=auto --git-ignore'
fi
