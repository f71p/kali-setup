#!/bin/sh
# restart-vm-tools — fix copy/paste (or resizing) when VMware Tools stops working.
# Replaces kali-tweaks' version, which starts the clipboard part as root under sudo and breaks it.
# Works with or without sudo. If the terminal still won't copy afterwards, reopen kitty/tmux.
if [ "$(id -u)" -eq 0 ]; then
    [ -n "${SUDO_USER:-}" ] || { echo "restart-vm-tools: run it as your user, not as root" >&2; exit 1; }
    exec sudo -u "$SUDO_USER" "$0"                  # the clipboard part must run as you
fi
sudo systemctl stop open-vm-tools
sudo killall -q -w vmtoolsd                         # every copy, including a clipboard one left running as root
sudo systemctl start open-vm-tools                  # system half
vmware-user-suid-wrapper 2>/dev/null                # clipboard half, as you
